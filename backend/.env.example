# Copy this file to .env and adjust as needed
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Use * during development to allow any origin.
CORS_ORIGIN=*

# Secret used to sign JWTs. CHANGE THIS before any real deployment —
# the value below is only a placeholder for the classroom project.
JWT_SECRET=techmaster-phase4-restaurant-secret-change-me
JWT_EXPIRES_IN=7d

# Credentials used to seed the one default admin (restaurant owner) account
# on first run. Change these before sharing the deployed URL widely.
DEFAULT_ADMIN_NAME=Restaurant Admin
DEFAULT_ADMIN_EMAIL=admin@techmaster.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
